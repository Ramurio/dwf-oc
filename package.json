{
  "name": "dwf",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26"
  },
  "scripts": {
    "test": "npm run test:harness && npm run test:product && npm run test:acceptance && npm run test:recovery && npm run test:workflow && npm run test:runtime",
    "test:acceptance": "cucumber-js --config cucumber.mjs --tags @controlled --format json:acceptance-results/opencode/controlled.json",
    "test:real": "cucumber-js --config cucumber.mjs --tags @real --format json:acceptance-results/opencode/real.json",
    "test:steps": "cucumber-js --config cucumber.mjs --dry-run",
    "test:harness": "node --test acceptance/harness.test.mjs acceptance/tester.test.mjs acceptance/isolation.test.mjs acceptance/benchmark.test.mjs",
    "test:mutation": "node acceptance/verify-lifetime-mutation.mjs",
    "dwf": "node dwf.mjs",
    "test:product": "node --test run-store.test.mjs workflow.test.mjs workflow-controls.test.mjs workflow-groups.test.mjs workflow-admission.test.mjs ui.test.mjs",
    "test:runtime": "node --test acceptance/runtime.test.mjs",
    "test:recovery": "cucumber-js --config cucumber.mjs --tags @recovery --format json:acceptance-results/opencode/recovery.json",
    "test:workflow": "cucumber-js --config cucumber.mjs --tags @workflow --format json:acceptance-results/opencode/workflow.json",
    "test:ui": "node --test ui.test.mjs && node --test prototypes/dwf-ui/qa/layout.test.mjs && node prototypes/dwf-ui/qa/paired-routes.test.mjs && node acceptance/ui-browser.mjs && node acceptance/ui-view-regressions.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1"
  },
  "bin": {
    "dwf": "./dwf.mjs"
  },
  "dependencies": {
    "@opencode/cli": "2.2.5",
    "@opencode/client": "2.2.5"
  },
  "allowScripts": {
    "@opencode/cli@2.2.5": true
  }
}
